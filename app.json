{
  "expo": {
    "name": "Music Quest",
    "slug": "master-quest-mobile",
    "scheme": "masterquest",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.masterquest.mobile",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F0"
      },
      "package": "com.masterquest.mobile",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Music Quest",
      "shortName": "Music Quest",
      "themeColor": "#FFF8F0",
      "backgroundColor": "#FFF8F0",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Music Quest potrzebuje dostępu do mikrofonu, żeby móc słuchać, jak śpiewasz nuty w Zaczarowanym Solfeżu."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
